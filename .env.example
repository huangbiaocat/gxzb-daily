# ====================================================================
# 环境配置模板：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
#     cp .env.example .env
# 所有键都可以用同名环境变量覆盖。
# ====================================================================

# ---------- 路径 ----------
# 页面产物根目录（每日页 / 归档页写在此目录，也是同步到 Web 服务器的目录）
SITE_DIR=./dist
# 运行数据目录（采集原始 / 每日入库 / infoid 台账），默认 ./data
#DATA_DIR=./data
# 运行日志目录，默认 <SITE_DIR>/logs
#LOG_DIR=./logs
# 核验报告目录，默认 <SITE_DIR>/reports
#REPORT_DIR=./reports
# 视觉设计基准模板（样式从这个文件内联提取，改动会触发构建失败）
#TEMPLATE_PREVIEW=./templates/index-preview.html
# 归档首页样板模板
#TEMPLATE_ARCHIVE_SAMPLE=./templates/index-sample.html

# ---------- 站点 ----------
SITE_BASE_URL=https://ztb.139771.xyz

# ---------- 采集 ----------
COLLECT_CENTERS=001,002,003,004,005,006,007,008,009,010,011,012,013,014,015
COLLECT_CATEGORY_PREFIX=001001
API_TIMEOUT=30
API_RETRY=2
API_PAGE_SIZE=500
# 重点预警关键词（标题命中即标记）
FOCUS_KEYWORDS=公路,医院,学校,安置,水库,治理,灌区,道路
# 重点跟踪配置（支持换行或逗号分隔，方便大版面多行批量粘贴输入）
FOCUS_PROJECTS=
FOCUS_OWNERS=
FOCUS_PROJECT_TYPES=
TIMEZONE=Asia/Shanghai

# ---------- 运行开关 ----------
# report：缺失条目只出核验报告（人工确认后再合并，默认）
# merge ：自动把缺失条目并入当日入库后生成页面（无人值守口径）
RECONCILE=report
# 生成完成后要执行的外部命令（如推送脚本），留空跳过
PUSH_CMD=

# ---------- 凭证（如后续接入推送 / 同步，统一写这里，不要写进代码）----------
# WECHAT_PUSH_TOKEN=
# SSH_HOST=
# SSH_USER=

# 自动化监控与定时调度（桌面端管理器可直接在界面修改）
MONITOR_START_TIME=08:00
MONITOR_END_TIME=20:00
MONITOR_INTERVAL_MINUTES=10
